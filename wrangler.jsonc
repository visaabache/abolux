// Cloudflare Worker for the store. See README.md for first-time setup.
{
  "name": "abolux",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // The Worker renders the storefront pages itself and passes /assets/* and /admin/* on to the static files.
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "abolux",
      // The live database, created with: npx wrangler d1 create abolux
      "database_id": "f2e8be85-4f92-436d-bee8-30ac682cdab8",
      "migrations_dir": "migrations"
    }
  ],
  // The store's public address. www.abolux.store and the workers.dev address redirect here, and it is used
  // for canonical links, the sitemap and Google's structured data.
  "vars": { "SITE_URL": "https://abolux.store" },
  // abolux.store must be added to this Cloudflare account (nameservers pointed to Cloudflare at the registrar).
  "routes": [
    { "pattern": "abolux.store", "custom_domain": true },
    { "pattern": "www.abolux.store", "custom_domain": true }
  ],
  // Still reachable at https://abolux.<your-subdomain>.workers.dev (it redirects to SITE_URL).
  "workers_dev": true,
  // Photo uploads from the admin need R2, which Cloudflare only turns on once a payment card is on the account
  // (the first 10 GB stay free). Until then, product photos can be links. To turn uploads on:
  //   npx wrangler r2 bucket create abolux-images
  // then add:  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "abolux-images" }],
  "observability": { "enabled": true }
}
